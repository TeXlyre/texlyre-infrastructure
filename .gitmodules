	tag = v10.3.0
	docker-image = y-webrtc-server
[submodule "services/peerjs-server"]
	path = services/peerjs-server
	url = https://github.com/TeXlyre/peerjs-server.git
	tag = v1.0.3
	docker-image = peerjs-server
[submodule "services/texlive-ondemand-server"]
	path = services/texlive-ondemand-server
	url = https://github.com/TeXlyre/texlive-ondemand-server.git
	tag = v2020.0.1
	docker-image = texlive-ondemand-server
[submodule "services/filepizza-server"]
	path = services/filepizza-server
	url = https://github.com/TeXlyre/filepizza-server.git
	tag = v2.1.1
	docker-image = filepizza-server
[submodule "services/texlyre-busytex-build"]
