COMPOSE_PROJECT_NAME=texlyre
ENVIRONMENT=local
BASE_DOMAIN=localhost
TRAEFIK_HOST=traefik.localhost
PORTAINER_HOST=portainer.localhost
FRONTEND_HOST=texlyre.localhost
PRODUCTION_DOMAIN=[YOUR_IP]  # get your private address and type it in place of [PRIVATE_IP] e.g., windows -> `ipconfig`; linux & mac -> `ifconfig`

BIND_IP=0.0.0.0  # Network accessible
HTTP_PORT=8082
HTTPS_PORT=8443

# Specifying the port is needed for services when network hosting (BIND_IP=0.0.0.0)
#  subdomain will still be served through traefik e.g., http://filepizza.localhost:8082 & https://filepizza.localhost:8443 (HTTP & HTTPS)
#  direct access will be served without traefik e.g., http://localhost:8083 & http://192.168.0.63:8083 -> FilePizza (HTTP ONLY)
HTTP_PORT_FILEPIZZA=8083
HTTP_PORT_TEXLIVE=8084
HTTP_PORT_YWEBRTC=8085
HTTP_PORT_PEERJS=8086
HTTP_PORT_TEXLIVE2026=8087
HTTP_PORT_PROXY=8088

# Built-in services. Use all (default), none, or a comma-separated subset of:
#  frontend,portainer,filepizza,ywebrtc,peerjs,texlive,texlive2026,proxy,redis
# Redis is also activated automatically by the filepizza and texlive2026 profiles.
SERVICES=all
COMPOSE_PROFILES=${SERVICES:-all}

# Frontend userdata: selects frontend/userdata.overrides/<variant>.json
TEXLYRE_USERDATA_VARIANT=traefik
## Override individual service URLs for direct (non-traefik) access, e.g.
#TEXLYRE_USERDATA={"settings":{"collab-signaling-servers":"ws://[YOUR_IP]:8085/","file-sync-server-url":"http://[YOUR_IP]:8083","latex-texlive-endpoint":"http://[YOUR_IP]:8084","latex-busytex-endpoint":"http://[YOUR_IP]:8087","repository-proxy-url":"http://[YOUR_IP]:8088/?url="}}

# Chelys recipes served alongside the stack, resolved by id from the recipe registry
#  <id>[@<version>][?<variable>=<value>&...], e.g. sile,ltex-ls-plus?language=en-GB
#  "npm run recipes:list" prints the available ids, "npm run recipes" regenerates
#  docker-compose.recipes.yml, then "npm run up:recipes" starts them
RECIPES=

## Repository proxy download allowlist, comma-separated, empty uses the built-in defaults
#PROXY_ALLOWED_HOSTS=github.com,githubusercontent.com,gitlab.com,codeberg.org
#PROXY_MAX_DOWNLOAD_BYTES=536870912  # Maximum size of download allowed through proxy in bytes 

# Custom properties generalized for multiple services
REDIS_PORT=6379  # Shared Redis port used by FilePizza and TeX Live 2026
API_ORIGINS=*  # Too relaxed, so you need to set it depending on how you limit CORS
## For local network hosting, you cannot remove PEERJS_SERVERS. However, if you plan on using localhost (without HTTPS),
##  you can still remove the env var and it will default to public (public requires internet connection)
PEERJS_SERVERS=http://${PRODUCTION_DOMAIN}:${HTTP_PORT_PEERJS}/texlyre/  # This is required by FilePizza

# TeXLive 2026 server, downloaded into a named volume on first start
TEXMF_URL=https://github.com/TeXlyre/texlyre-busytex-build/releases/download/texlive-full-2026.1.0/texmf-dist.tar.zst
## Or point at an existing texmf-dist tree on the host, absolute path, to skip the download
#TEXMF_ROOT=/absolute/path/to/texlive-full/texmf-dist
